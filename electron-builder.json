{
  "appId": "app.senda.transfer",
  "productName": "Senda",
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/**/*",
    "public/senda-icon-256.png",
    "!node_modules/**/*"
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "public/senda-icon-256.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
